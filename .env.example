# Database — PostgreSQL connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth — random secret used to sign session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: server-side timezone for date handling
TZ="Asia/Karachi"
