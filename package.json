{
  "name": "finkeep",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:component": "vitest run --config vitest.config.component.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:debug": "playwright test --project=chromium --headed --debug",
    "test:e2e:auth": "playwright test tests/e2e/auth.spec.ts --project=chromium",
    "test:e2e:authenticated": "playwright test --project=auth-setup --project=authenticated",
    "test:e2e:pwa": "playwright test tests/e2e/pwa.spec.ts --project=chromium",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "test:e2e:security": "playwright test tests/e2e/security-headers.spec.ts --project=chromium",
    "test:smoke": "vitest run --config vitest.config.ts && playwright test tests/e2e/auth.spec.ts tests/e2e/pwa.spec.ts --project=chromium",
    "test:regression": "vitest run --config vitest.config.ts && vitest run --config vitest.config.component.ts && playwright test",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest",
    "test:ci": "vitest run --config vitest.config.ts && vitest run --config vitest.config.component.ts",
    "test:demo": "playwright test --project=chromium --headed --reporter=list",
    "postinstall": "prisma generate || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "lucide-react": "^0.468.0",
    "next": "^14.2.21",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "fast-check": "^4.10.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
